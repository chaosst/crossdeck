{
  "name": "crossdeck",
  "version": "0.0.0",
  "private": true,
  "description": "One platform-agnostic core, multiple shells — Agent desktop client (Electron / Web / HarmonyOS)",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:electron": "pnpm --filter @crossdeck/shell-electron setup:electron",
    "build": "pnpm --filter @crossdeck/shell-electron build",
    "dev": "pnpm --filter @crossdeck/shell-electron dev",
    "start": "pnpm --filter @crossdeck/shell-electron start",
    "selfcheck": "pnpm --filter @crossdeck/shell-electron selfcheck && node scripts/archive-selfcheck.mjs",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean",
    "verify:ipc": "node scripts/verify-type-alignment.mjs",
    "verify:core-purity": "node scripts/verify-core-purity.mjs",
    "verify:scope": "node scripts/verify-core-scope.mjs",
    "verify": "pnpm typecheck && pnpm verify:core-purity && pnpm verify:ipc && pnpm verify:scope"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
