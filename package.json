{
  "name": "crossdeck",
  "version": "0.0.0",
  "private": true,
  "description": "One platform-agnostic core, multiple shells — Agent desktop client (Electron / Web / HarmonyOS)",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:electron": "pnpm --filter @crossdeck/shell-electron setup:electron",
    "build": "pnpm --filter @crossdeck/shell-electron build",
    "dev": "pnpm --filter @crossdeck/shell-electron dev",
    "start": "pnpm --filter @crossdeck/shell-electron start",
    "selfcheck": "pnpm --filter @crossdeck/shell-electron selfcheck && node scripts/archive-selfcheck.mjs",
    "pack:win": "pnpm --filter @crossdeck/shell-electron pack:win",
    "build:web": "pnpm --filter @crossdeck/shell-web build",
    "dev:web": "pnpm --filter @crossdeck/shell-web dev",
    "selfcheck:web": "pnpm --filter @crossdeck/shell-web build && node packages/shell-web/scripts/web-selfcheck.mjs",
    "typecheck": "tsc -b",
    "typecheck:clean": "tsc -b --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:lint": "node scripts/verify-lint-boundaries.mjs",
    "verify:ipc": "node scripts/verify-type-alignment.mjs",
    "verify:core-purity": "node scripts/verify-core-purity.mjs",
    "verify:scope": "node scripts/verify-core-scope.mjs",
    "verify:sse": "node scripts/verify-core-sse.mjs",
    "verify:model": "node scripts/verify-model-stream.mjs",
    "verify:agent": "node scripts/verify-core-agent.mjs",
    "verify:update": "node scripts/verify-core-update.mjs",
    "verify:navigate-client": "node scripts/verify-navigate-client.mjs",
    "verify:navigate-client-ohos": "node scripts/verify-navigate-client-ohos.mjs",
    "verify:navigate-auth": "node scripts/verify-navigate-auth.mjs",
    "verify:shared-fresh": "node scripts/verify-shared-fresh.mjs",
    "verify:ohos-judge": "node packages/shell-ohos/scripts/verify-ohos-judge.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm verify:core-purity && pnpm verify:ipc && pnpm verify:lint && pnpm verify:scope && pnpm verify:sse && pnpm verify:model && pnpm verify:agent && pnpm verify:update && pnpm verify:navigate-client && pnpm verify:navigate-client-ohos && pnpm verify:navigate-auth && pnpm verify:shared-fresh && pnpm verify:ohos-judge",
    "verify:update-feed": "pnpm --filter @crossdeck/shell-electron verify:update-feed",
    "sync:ohos": "node packages/shell-ohos/scripts/sync-shared.mjs",
    "verify:ohos": "node packages/shell-ohos/scripts/verify-ohos.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "typescript": "^5.6.0"
  }
}
