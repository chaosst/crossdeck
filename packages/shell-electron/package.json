{
  "name": "@crossdeck/shell-electron",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "crossdeck 桌面壳 —— 一个平台无关的 core，多端壳（Electron / Web / HarmonyOS）",
  "author": "crossdeck",
  "main": "dist/main/index.cjs",
  "dependencies": {
    "@crossdeck/contract": "workspace:*",
    "@crossdeck/core": "workspace:*",
    "@crossdeck/ui": "workspace:*",
    "electron-updater": "^6.8.9"
  },
  "scripts": {
    "setup:electron": "node scripts/setup-electron.mjs",
    "icons": "node scripts/icons.mjs",
    "build": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs --main-only",
    "start": "node scripts/build.mjs && node scripts/launch.mjs",
    "dev": "node scripts/build.mjs --main-only && node scripts/launch.mjs --dev",
    "debug:main": "node scripts/build.mjs && node scripts/launch.mjs --inspect=9229",
    "selfcheck": "node scripts/build.mjs && node scripts/launch.mjs --selfcheck",
    "pack:win": "node scripts/build.mjs && electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc -b",
    "verify:store": "node scripts/verify-renderer-store.mjs",
    "verify:update-feed": "node scripts/verify-update-feed.mjs",
    "verify:stream-binding": "node scripts/verify-agent-stream-binding.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
